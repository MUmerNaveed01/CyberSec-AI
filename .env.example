# =============================================================================
# AI Cybersecurity Assessment Platform — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real values to source control.
# =============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_NAME="CyberSec Platform"
APP_ENV=development          # development | production
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ----------------------------------------------------------------------------
# Database — PostgreSQL
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://cybersec:changeme@postgres:5432/cybersecdb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# For Alembic migrations (sync driver)
ALEMBIC_DATABASE_URL=postgresql://cybersec:changeme@postgres:5432/cybersecdb

# Postgres container credentials
POSTGRES_USER=cybersec
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cybersecdb

# ----------------------------------------------------------------------------
# Redis / Celery
# ----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ----------------------------------------------------------------------------
# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------------------
# AI Provider
# ----------------------------------------------------------------------------
AI_PROVIDER=openai          # openai | anthropic
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# ----------------------------------------------------------------------------
# File Uploads / Scanning
# ----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
SCANNER_REQUEST_TIMEOUT=30
SCANNER_MAX_REDIRECTS=5

# Temporary directory for scan artifacts (cleaned up after use)
SCAN_TEMP_DIR=/tmp/cybersec_scans

# ----------------------------------------------------------------------------
# Frontend (Next.js public variables — safe to expose to browser)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="CyberSec Platform"

# ----------------------------------------------------------------------------
# Nginx (reverse proxy)
# ----------------------------------------------------------------------------
NGINX_HOST=localhost
NGINX_PORT=80
